{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "www",
  "buildCommand": "sed -i \"s/__VERSION__/${VERCEL_GIT_COMMIT_SHA:0:7}/\" www/sw.js",
  "installCommand": "echo sin dependencias que instalar",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
